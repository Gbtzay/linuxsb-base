{
  "name": "linuxsb-base",
  "version": "2.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs --profile=release && node build-suite.mjs --profile=release && node build-lts.mjs --profile=release",
    "build:dev": "node build.mjs --profile=dev && node build-suite.mjs --profile=dev",
    "build:skin": "node scripts/build-skin.mjs",
    "verify:skin": "node scripts/build-skin.mjs --check",
    "verify:dist": "node scripts/check-dist.mjs",
    "verify:dev-dist": "node scripts/check-dev-dist.mjs",
    "verify:profiles": "npm run verify:dist && npm run verify:dev-dist",
    "verify:test-skips": "node scripts/check-test-skips.mjs",
    "smoke:ios27": "node scripts/ios27-canvas-smoke.mjs",
    "smoke:legacy": "node scripts/legacy-home-scroll-smoke.mjs",
    "smoke:reading": "node scripts/reading-browser-smoke.mjs",
    "smoke:browser": "npm run smoke:legacy && npm run smoke:ios27 && npm run smoke:reading",
    "test": "node scripts/run-tests.mjs quick",
    "test:quick": "node scripts/run-tests.mjs quick",
    "test:core": "node scripts/run-tests.mjs core",
    "test:all": "node scripts/run-tests.mjs all",
    "test:ai": "node scripts/run-tests.mjs ai",
    "test:live-feed": "node scripts/run-tests.mjs live-feed",
    "test:skin": "node scripts/run-tests.mjs skin"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "jsdom": "26.1.0",
    "playwright": "^1.63.0"
  }
}
